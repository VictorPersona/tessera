{
  "name": "tessera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "test": "vitest run",
    "build": "pnpm tsc --noEmit && swc apps -d dist",
    "start": "node dist/apps/api/index.js",
    "dev": "nodemon --watch apps --ext ts --exec \"pnpm build && pnpm start\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "nodemon": "^3.1.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5"
  }
}
