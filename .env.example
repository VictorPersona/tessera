# development | test | production
NODE_ENV=development
# HTTP port for the api, 1-65535
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Compose: credentials for the postgres container. Used only when its data dir is empty (first init)
POSTGRES_USER=postgres
# Secret. Must match the password in DATABASE_URL
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tessera
# Host port Postgres is published on; default 5432. Set another (e.g. 7447) if a local Postgres holds 5432, and use the same port in DATABASE_URL
POSTGRES_HOST_PORT=5432

# Required, secret. postgres:// or postgresql:// URL; user, password and db must match POSTGRES_* above (port = POSTGRES_HOST_PORT)
DATABASE_URL=postgres://postgres:change-me@localhost:5432/tessera
# Max connections in each process's pool, >= 1
DATABASE_POOL_MAX=10
# pg application_name, shown in pg_stat_activity; empty = tessera-api / tessera-worker
DATABASE_APP_NAME=

# S3 endpoint URL; SeaweedFS from the laptop (from another container: http://seaweedfs:8333); empty for real AWS
S3_ENDPOINT=http://localhost:8333
# S3 region
S3_REGION=us-east-1
# Required, secret. Also seeds SeaweedFS (compose.yaml passes it as AWS_ACCESS_KEY_ID)
S3_ACCESS_KEY_ID=change-me
# Required, secret. Never printed, not even when malformed; seeds SeaweedFS as AWS_SECRET_ACCESS_KEY
S3_SECRET_ACCESS_KEY=change-me
# Bucket for uploaded documents; SeaweedFS creates it on start
S3_BUCKET=tessera-documents
# true | false; path-style URLs (bucket in the path), which SeaweedFS needs
S3_FORCE_PATH_STYLE=true

# Graceful-shutdown budget in ms, 1000-60000; must be < 10000 in production (Docker's stop grace period)
SHUTDOWN_TIMEOUT_MS=8000
# Readiness probe's database check timeout in ms, 100-5000
READINESS_DB_TIMEOUT_MS=1000

# OTLP collector URL; empty = telemetry off
OTEL_EXPORTER_OTLP_ENDPOINT=
