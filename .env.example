# development | test | production
NODE_ENV=development
# HTTP port for the api, 1-65535
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Compose: credentials for the postgres container. Used only when its data dir is empty (first init)
POSTGRES_USER=postgres
# Secret. Must match the password in DATABASE_URL
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tessera

# Required, secret. postgres:// or postgresql:// URL; user, password and db must match POSTGRES_* above (compose.yaml maps Postgres to localhost:7447)
DATABASE_URL=postgres://postgres:change-me@localhost:7447/tessera
# Max connections in each process's pool, >= 1
DATABASE_POOL_MAX=10
# pg application_name, shown in pg_stat_activity; empty = tessera-api / tessera-worker
DATABASE_APP_NAME=

# S3 endpoint URL; set for SeaweedFS locally, leave empty for real AWS
S3_ENDPOINT=
# S3 region
S3_REGION=us-east-1
# Required, secret. Any non-empty value works locally until SeaweedFS is set up
S3_ACCESS_KEY_ID=
# Required, secret. Never printed, not even when malformed
S3_SECRET_ACCESS_KEY=
# Bucket for uploaded documents
S3_BUCKET=tessera-documents
# true | false; path-style URLs (bucket in the path), which SeaweedFS needs
S3_FORCE_PATH_STYLE=false

# Graceful-shutdown budget in ms, 1000-60000; must be < 10000 in production (Docker's stop grace period)
SHUTDOWN_TIMEOUT_MS=8000
# Readiness probe's database check timeout in ms, 100-5000
READINESS_DB_TIMEOUT_MS=1000

# OTLP collector URL; empty = telemetry off
OTEL_EXPORTER_OTLP_ENDPOINT=
